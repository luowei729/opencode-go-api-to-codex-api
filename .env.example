# Server port
PORT=3000

# OpenCode Go API upstream base URL
UPSTREAM_BASE_URL=https://opencode.ai/zen/go

# OpenCode Go authentication token
# Get your token from https://opencode.ai/auth
# If not set here, the proxy will pass through the client's Authorization header
OPENCODE_TOKEN=your_opencode_go_token_here

# Default model to use for all requests (overrides client model)
# Available: glm-5.1, glm-5, kimi-k2.6, kimi-k2.5, deepseek-v4-pro, deepseek-v4-flash,
#            mimo-v2.5, mimo-v2.5-pro, minimax-m3, minimax-m2.7, minimax-m2.5,
#            qwen3.7-max, qwen3.7-plus, qwen3.6-plus
# DEFAULT_MODEL=kimi-k2.6

# Model name mapping (format: from1:to1,from2:to2)
# Maps Codex model names to OpenCode Go model names
# MODEL_MAP=gpt-5.5:kimi-k2.6,gpt-4:kimi-k2.5

# Web UI 管理密码（保护上游 Token 池和本地 Token 的管理接口）
# 必须设置，否则管理 API 返回 500
WEB_PASSWORD=your_web_password_here
